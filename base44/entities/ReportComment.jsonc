{
  "name": "ReportComment",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string",
      "description": "ID of the Report this comment belongs to"
    },
    "comment_text": {
      "type": "string",
      "description": "The comment content"
    },
    "commented_by": {
      "type": "string",
      "description": "Email of the commenter"
    },
    "commenter_name": {
      "type": "string",
      "description": "Display name of the commenter"
    },
    "section_index": {
      "type": "number",
      "description": "Index of the report section this comment is attached to"
    },
    "company_id": {
      "type": "string",
      "description": "Tenant / company this comment belongs to"
    }
  },
  "required": [
    "report_id",
    "comment_text"
  ]
}